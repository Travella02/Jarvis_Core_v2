  "client_protocol": {
    "name": "jarvis-runtime",
    "version": 1,
    "transports": [
      "http-json",
      "websocket-json"
    ],
    "client_platforms": [
      "windows",
      "macos",
      "linux",
      "ios",
      "android"
    ],
    "exposure": "loopback-only",
    "typed_command_endpoint": "POST /v1/runtime/commands/typed",
    "cancel_command_endpoint": "POST /v1/runtime/commands/{command_id}/cancel"
  },
  "runtime_invariants": [
    "JarvisRuntime and the existing Conversation Core remain authoritative across client input and reconnect",
    "clients never choose Jarvis correlation_id, request_id, turn_id, or cancellation_id values",
    "every client command targets the current runtime_id and conversation_id before execution",
    "one runtime-scoped client_request_id binds to one typed-command payload and duplicate retry never executes the provider twice",
    "a second client command is rejected while the foreground Core is busy rather than entering a hidden client-owned queue",
    "client cancellation delegates to Conversation Core cooperative cancellation",
    "client command lifecycle/results are emitted on the existing authoritative EventBus and use the existing replay cursor contract",
    "the unauthenticated Runtime API remains loopback-only"
  ],
  "known_limitations": [
    "client command idempotency/history is memory-only and resets with a new runtime_id",
    "durable command queueing is deferred",
    "authenticated LAN/WAN/mobile-to-desktop transport and device pairing are deferred",
    "desktop/mobile production UI is deferred",
    "tools, permissions, Memory 2.0, autonomous jobs, and durable redacted persistence are deferred",
    "fuzzy wake-word correction such as Jervis to Jarvis is deferred"
  ],

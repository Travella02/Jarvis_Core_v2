{
  "name": "jarvis-core-v2",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis Core v2 Desktop Alpha: Electron/React thin client over authoritative Jarvis Core with Realtime Mini + Cedar + WebRTC.",
  "main": "apps/desktop/electron/main.cjs",

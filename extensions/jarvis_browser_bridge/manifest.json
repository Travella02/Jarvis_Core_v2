{
  "manifest_version": 3,
  "name": "Jarvis Browser Bridge",
  "version": "0.1.5",
  "minimum_chrome_version": "116",
  "description": "Opt-in local browser extension for Jarvis Core v2. Browser actions require independently verified spoken authorization.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Jarvis Browser Bridge"
  }
}

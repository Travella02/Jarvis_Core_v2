# Jarvis Core v2 development configuration template.
# Copy to .env for local development only. Never commit real secrets.

JARVIS_ENV=development

# 0.0.2 Intelligence Provider
OPENAI_API_KEY=replace_me_in_local_env_only
JARVIS_OPENAI_MODEL=gpt-5.6-luna
JARVIS_OPENAI_REASONING_EFFORT=none
JARVIS_OPENAI_MAX_OUTPUT_TOKENS=4096
JARVIS_OPENAI_VOICE_MAX_OUTPUT_TOKENS=256
JARVIS_OPENAI_SERVICE_TIER=auto
# Voice Lab can opt into persistent Responses WebSocket continuation.
JARVIS_OPENAI_VOICE_TRANSPORT=http
JARVIS_OPENAI_TIMEOUT_SECONDS=60

# Optional OpenAI account routing. Leave blank unless your API setup requires them.
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=

# 0.0.4 Local Voice Lab
# STT candidate: whisper.cpp + large-v3-turbo-q5_0
JARVIS_WHISPER_SERVER_EXE=.runtime/voice/whisper_cpp/bin/whisper-server.exe
JARVIS_WHISPER_MODEL=.runtime/voice/whisper_cpp/models/ggml-large-v3-turbo-q5_0.bin
JARVIS_WHISPER_HOST=127.0.0.1
JARVIS_WHISPER_PORT=18080
JARVIS_WHISPER_LANGUAGE=en
JARVIS_WHISPER_PARTIAL_MS=900
JARVIS_WHISPER_MIN_PARTIAL_MS=900
JARVIS_WHISPER_THREADS=8
JARVIS_WHISPER_USE_GPU=1

# TTS candidate: Chatterbox Turbo in its own isolated runtime.
JARVIS_CHATTERBOX_PYTHON=.runtime/voice/chatterbox/.venv/Scripts/python.exe
JARVIS_CHATTERBOX_DEVICE=cuda
JARVIS_CHATTERBOX_FRAME_MS=20

# Optional 0.0.4 A/B TTS candidate: Qwen3-TTS 12Hz 0.6B Base.
JARVIS_QWEN3_TTS_PYTHON=.runtime/voice/qwen3_tts/.venv/Scripts/python.exe
JARVIS_QWEN3_TTS_MODEL_DIR=.runtime/voice/qwen3_tts/models/Qwen3-TTS-12Hz-0.6B-Base
JARVIS_QWEN3_TTS_DEVICE=cuda
JARVIS_QWEN3_TTS_DTYPE=bfloat16
JARVIS_QWEN3_TTS_ATTENTION=sdpa
JARVIS_QWEN3_TTS_FRAME_MS=20

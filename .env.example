# Jarvis Core v2 development configuration template.
# Copy to .env for local development only. Never commit real secrets.

JARVIS_ENV=development

# 0.0.2 Intelligence Provider
OPENAI_API_KEY=replace_me_in_local_env_only
JARVIS_OPENAI_MODEL=gpt-5.6-luna
JARVIS_OPENAI_REASONING_EFFORT=medium
JARVIS_OPENAI_MAX_OUTPUT_TOKENS=4096
JARVIS_OPENAI_TIMEOUT_SECONDS=60

# Optional OpenAI account routing. Leave blank unless your API setup requires them.
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=

# Jarvis Core v2 development configuration template.
# Copy to .env for local development only. Never commit real secrets.

JARVIS_ENV=development

# 0.0.2 Intelligence Provider
OPENAI_API_KEY=replace_me_in_local_env_only
JARVIS_OPENAI_MODEL=gpt-6-luna
JARVIS_OPENAI_REASONING_EFFORT=none
# Optional stronger delegated-reasoning route. Leave blank to keep all delegated reasoning on the default model.
JARVIS_OPENAI_STRONG_MODEL=
JARVIS_OPENAI_STRONG_REASONING_EFFORT=low
JARVIS_OPENAI_MAX_OUTPUT_TOKENS=4096
JARVIS_OPENAI_VOICE_MAX_OUTPUT_TOKENS=256
JARVIS_OPENAI_SERVICE_TIER=default
# Exact model ID is intentionally configurable; promote new Luna versions only after ORVEX validation.
# Standard pricing is explicit by default; Fast mode must be deliberately requested.
# Voice Lab can opt into persistent Responses WebSocket continuation.
JARVIS_OPENAI_VOICE_TRANSPORT=http
JARVIS_OPENAI_TIMEOUT_SECONDS=60

# Optional OpenAI account routing. Leave blank unless your API setup requires them.
# OPENAI_PROJECT_ID=
# OPENAI_ORG_ID=
# OPENAI_BASE_URL=

# 0.0.4 Local Voice Lab
# STT candidate: whisper.cpp + large-v3-turbo-q5_0
JARVIS_WHISPER_SERVER_EXE=.runtime/voice/whisper_cpp/bin/whisper-server.exe
JARVIS_WHISPER_MODEL=.runtime/voice/whisper_cpp/models/ggml-large-v3-turbo-q5_0.bin
JARVIS_WHISPER_HOST=127.0.0.1
JARVIS_WHISPER_PORT=18080
JARVIS_WHISPER_LANGUAGE=en
JARVIS_WHISPER_PARTIAL_MS=900
JARVIS_WHISPER_MIN_PARTIAL_MS=900
JARVIS_WHISPER_THREADS=8
JARVIS_WHISPER_USE_GPU=1

# TTS candidate: Chatterbox Turbo in its own isolated runtime.
JARVIS_CHATTERBOX_PYTHON=.runtime/voice/chatterbox/.venv/Scripts/python.exe
JARVIS_CHATTERBOX_DEVICE=cuda
JARVIS_CHATTERBOX_FRAME_MS=20

# Optional 0.0.4 A/B TTS candidate: Qwen3-TTS 12Hz 0.6B Base.
JARVIS_QWEN3_TTS_PYTHON=.runtime/voice/qwen3_tts/.venv/Scripts/python.exe
JARVIS_QWEN3_TTS_MODEL_DIR=.runtime/voice/qwen3_tts/models/Qwen3-TTS-12Hz-0.6B-Base
JARVIS_QWEN3_TTS_DEVICE=cuda
JARVIS_QWEN3_TTS_DTYPE=bfloat16
JARVIS_QWEN3_TTS_ATTENTION=sdpa
JARVIS_QWEN3_TTS_FRAME_MS=20

# 0.0.5 realtime conversation lifecycle. Separate phrases with |.
# Defaults are intentionally configurable so future users can choose another wake phrase.
JARVIS_WAKE_PHRASES=hey jarvis|jarvis
JARVIS_SLEEP_PHRASES=that's all|that's all jarvis|go to sleep|go to sleep jarvis|goodnight jarvis
JARVIS_IDLE_SLEEP_SECONDS=60

# 0.0.6 Runtime State & Event Foundation
# Non-secret orchestration settings only. Provider credentials stay in provider adapters.
JARVIS_DEFAULT_INTELLIGENCE_ROUTE=primary
JARVIS_RUNTIME_EVENT_HISTORY=1024
JARVIS_PROVIDER_HEALTH_TIMEOUT_SECONDS=2.0

# 0.0.7 Local Runtime API
# Loopback-only in this milestone. Do not expose the unauthenticated local API to LAN/WAN.
JARVIS_RUNTIME_API_HOST=127.0.0.1
JARVIS_RUNTIME_API_PORT=8766
JARVIS_RUNTIME_API_EVENT_QUEUE=256
JARVIS_RUNTIME_API_MAX_REPLAY=512
JARVIS_RUNTIME_API_HEARTBEAT_SECONDS=15

# 0.0.9 optional GPT-Live full-duplex voice frontend A/B prototype.
# Uses the same OPENAI_API_KEY as Luna; no second secret is required.
# Client delegation keeps Jarvis Core/Luna as reasoning and state authority.
JARVIS_GPT_LIVE_MODEL=gpt-live-1
JARVIS_GPT_LIVE_VOICE=meridian
JARVIS_GPT_LIVE_URL=wss://api.openai.com/v1/live/sessions
JARVIS_GPT_LIVE_AUDIO_RATE_HZ=24000
JARVIS_GPT_LIVE_WEBRTC_URL=https://api.openai.com/v1/live/sessions
JARVIS_GPT_LIVE_OPEN_TIMEOUT_SECONDS=20
JARVIS_GPT_LIVE_CLOSE_TIMEOUT_SECONDS=15

# Preferred 0.0.9 conversational frontend (swappable)
JARVIS_REALTIME_MODEL=gpt-realtime-2.1-mini
JARVIS_REALTIME_VOICE=cedar
JARVIS_REALTIME_REASONING_EFFORT=low
JARVIS_REALTIME_WEBRTC_URL=https://api.openai.com/v1/realtime/calls
JARVIS_REALTIME_OPEN_TIMEOUT_SECONDS=20
